# Milestones 1-4 (ingest, expandRule, addon server, admin UI). More
# variables will be added here as later milestones land.

# --- Postgres ---------------------------------------------------------
# Used directly by the postgres container, and folded into DATABASE_URL
# below for the app. Change the password before any real deployment.
POSTGRES_USER=torbox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=torbox_ru

# Connection string the app uses. Host "postgres" is the docker-compose
# service name; use "localhost" when running the app outside Docker
# against a locally-forwarded port.
DATABASE_URL=postgresql://torbox:changeme@postgres:5432/torbox_ru

# --- TorBox -------------------------------------------------------------
# Bearer token from your TorBox account settings. Required.
TORBOX_API_KEY=

# Minimum delay (ms) between per-torrent file-list requests during ingest.
# TorBox does not publish a rate limit; this is a conservative default.
TORBOX_REQUEST_DELAY_MS=250

# --- Logging --------------------------------------------------------------
# One of: fatal error warn info debug trace silent
LOG_LEVEL=info
NODE_ENV=production

# --- Addon server (Milestone 3, src/http) ----------------------------------
# Shared secret in the addon URL path (/:token/manifest.json, etc. -- §5.5).
# Anyone with this value can browse and stream your TorBox library, so treat
# it like a password. Generate one with: openssl rand -hex 32
ADDON_TOKEN=

# Base URL Stremio/AIOStreams use to reach this addon -- your Cloudflare
# Tunnel hostname in production (e.g. https://torbox-ru.example.com), or a
# local/LAN URL while testing before the tunnel is wired up. No trailing
# slash.
PUBLIC_BASE=

# Port the addon server listens on inside the container.
PORT=3000

# Comma-separated file extensions (no dot) flagged notWebReady: true in
# Stream objects -- MPEG-TS (.ts) files are common in this library and
# generally are not directly web-playable.
NOT_WEB_READY_EXTENSIONS=ts

# --- Admin UI (Milestone 4, src/ui + /admin, /api) --------------------------
# HTTP Basic Auth credentials gating the Labeller UI and its API -- reachable
# from the same public Cloudflare Tunnel as the addon, so both are required
# with no default. Pick a real password, not the example below.
ADMIN_USER=admin
ADMIN_PASS=

# TMDB API key (v3 key or v4 Bearer/JWT token, both supported) for the show
# picker's search and season-episode-count lookups. Optional: the picker
# just returns no results without it, nothing else depends on it.
TMDB_API_KEY=

# --- RuTracker feed scraper (docs/rutracker-scraper-plan.md) ---------------
# Comma-separated Atom feed URLs to poll every ingest run. Optional: defaults
# to https://feed.rutracker.cc/atom/f/939.atom if unset.
RUTRACKER_FEED_URLS=

# Persist feed entries with no matching Library title (for debugging the
# matcher). Optional, off by default.
RUTRACKER_STORE_UNMATCHED=false

# Base URL of a FlareSolverr instance, needed only for the Feed tab's manual
# "Download" action and the Discord notification's download link -- both
# fetch a matched entry's magnet link by driving a real
# (Cloudflare-Turnstile-solving) browser through FlareSolverr. A plain
# server-side request to RuTracker gets blocked by Cloudflare outright; see
# docs/rutracker-scraper-plan.md for how this was verified. Defaults to
# http://flaresolverr:8191 (docker-compose.yml's own flaresolverr service)
# if unset -- only override this if you're pointing at a FlareSolverr
# instance running somewhere else instead. Optional either way: the
# Download action just reports a clear error if nothing is reachable.
FLARESOLVERR_URL=

# Discord incoming webhook URL. Optional and off by default -- when set, a
# message is posted for every new feed entry that matches a Library show,
# with a link back to the Download action above.
DISCORD_WEBHOOK_URL=
