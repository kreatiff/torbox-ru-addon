{
  "name": "torbox-ru-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "ingest": "tsx --env-file=.env src/ingest/runOnce.ts",
    "migrate:create": "node-pg-migrate create --",
    "migrate:up": "tsx --env-file=.env -e \"import('./src/db/migrate.ts').then(m=>m.migrateUp())\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
